Output docs/assets/terminal-demo.gif

Set Shell "zsh"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1280
Set Height 720
Set Padding 24
Set Theme { "name": "Agent Coordinator", "background": "#11131b", "foreground": "#d8dee9", "black": "#11131b", "brightBlack": "#64748b", "red": "#ff5f57", "brightRed": "#ff7b72", "green": "#28c840", "brightGreen": "#86efac", "yellow": "#febc2e", "brightYellow": "#fde68a", "blue": "#67e8f9", "brightBlue": "#a5f3fc", "magenta": "#c084fc", "brightMagenta": "#d8b4fe", "cyan": "#67e8f9", "brightCyan": "#a5f3fc", "white": "#d8dee9", "brightWhite": "#f8fafc" }

Type "coordinator demo"
Sleep 500ms
Enter
Sleep 3s
